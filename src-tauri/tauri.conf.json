{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ledwall Designer",
  "version": "1.0.1",
  "identifier": "com.ats.ledwalldesigner",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ledwall Designer",
        "width": 1500,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Offline LED wall design and technical documentation",
    "longDescription": "Design LED wall layouts, plan data and power cabling, check NovaStar controller capacity, and export pixel maps and technical reports.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "license": "GPL-3.0-only",
    "homepage": "https://lorenzoapra.github.io/Ledwall-Designer/",
    "resources": {
      "../LICENSE": "LICENSE"
    }
  }
}
